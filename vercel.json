{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "MONGOMS_DISABLE_POSTINSTALL=1 npm ci --include=dev",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "client/dist",
  "build": {
    "env": {
      "MONGOMS_DISABLE_POSTINSTALL": "1"
    }
  },
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{server/package.json,node_modules/pdfkit/js/data/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/uploads/(.*)", "destination": "/api" },
    { "source": "/sitemap.xml", "destination": "/api" },
    { "source": "/robots.txt", "destination": "/api" },
    { "source": "/((?!api/|uploads/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(sw.js|push-sw.js|registerSW.js|manifest.webmanifest|index.html)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "crons": [{ "path": "/api/v1/internal/cron/all", "schedule": "0 22 * * *" }]
}
