# Souqly server environment. Copy to server/.env. Every key is optional in development:
# missing integrations fall back to local/dev implementations (see CLAUDE.md "Dev fallbacks").

# --- Core ---
# development | test | production
NODE_ENV=development
# HTTP port of the API server
PORT=4000
# Public URL of the web client (used for CORS and links in emails)
CLIENT_URL=http://localhost:5173
# Public URL of this API server (OAuth callback URLs); defaults to http://localhost:PORT
SERVER_URL=http://localhost:4000
# MongoDB connection string; empty in development = in-memory MongoDB (data resets on restart, auto-seeded)
MONGODB_URI=
# Secret for 15-minute access JWTs (>= 32 chars; required in production; random per boot in dev if empty)
JWT_ACCESS_SECRET=
# Secret for refresh-token related signing and key derivation (>= 32 chars; required in production)
JWT_REFRESH_SECRET=
# Key for AES-256-GCM encryption of data at rest (2FA secrets); derived from JWT_REFRESH_SECRET if empty
DATA_ENCRYPTION_KEY=
# Force the Secure flag on auth cookies (defaults to true in production)
COOKIE_SECURE=
# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=

# --- Seeded Super Admin (created once if missing; an existing admin's password is never overwritten) ---
# Super Admin login email
ADMIN_EMAIL=souqly@gmail.com
# Super Admin initial password (change it after first login)
ADMIN_PASSWORD=souqly123
# Super Admin display name
ADMIN_NAME=Souqly Admin

# --- Cloudinary image storage (fallback: local disk server/uploads served at /uploads) ---
# Cloudinary cloud name
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key
CLOUDINARY_API_KEY=
# Cloudinary API secret
CLOUDINARY_API_SECRET=

# --- SMTP email (fallback: emails are printed to the server console) ---
# SMTP server host
SMTP_HOST=
# SMTP port (465 = implicit TLS, 587 = STARTTLS)
SMTP_PORT=587
# SMTP username
SMTP_USER=
# SMTP password
SMTP_PASS=
# From header for outgoing email
SMTP_FROM=Souqly <no-reply@souqly.pk>

# --- Twilio SMS / WhatsApp (fallback: messages printed to console; OTP devCode returned in dev) ---
# Twilio account SID
TWILIO_ACCOUNT_SID=
# Twilio auth token
TWILIO_AUTH_TOKEN=
# Twilio SMS sender number in E.164, e.g. +15005550006
TWILIO_FROM_NUMBER=
# Twilio WhatsApp sender number in E.164
TWILIO_WHATSAPP_FROM=

# --- Google login (fallback: "Continue with Google" button hidden) ---
# OAuth client id (redirect URI: SERVER_URL/api/v1/auth/google/callback)
GOOGLE_CLIENT_ID=
# OAuth client secret
GOOGLE_CLIENT_SECRET=

# --- Jobs (fallback: in-process scheduler; Redis/BullMQ not wired yet) ---
# Redis connection URL
REDIS_URL=

# --- Payments (fallback: Cash on Delivery only; others show "coming soon") ---
# Stripe secret key
STRIPE_SECRET_KEY=
# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=
# JazzCash merchant id
JAZZCASH_MERCHANT_ID=
# JazzCash password
JAZZCASH_PASSWORD=
# JazzCash integrity salt
JAZZCASH_INTEGRITY_SALT=
# EasyPaisa store id
EASYPAISA_STORE_ID=
# EasyPaisa hash key
EASYPAISA_HASH_KEY=

# --- Web push (fallback: push notifications disabled) ---
# VAPID public key (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
# VAPID private key
VAPID_PRIVATE_KEY=
# VAPID subject, e.g. mailto:support@souqly.pk
VAPID_SUBJECT=

# --- AI (fallback: AI description helper flag forced off) ---
# OpenAI API key for the product description helper
OPENAI_API_KEY=
