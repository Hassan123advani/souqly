# Optional. Override the API origin (default: same origin "/api/v1", proxied by Vite in dev).
VITE_API_URL=
# Optional. Google Maps JS key; when empty the app uses Leaflet + OpenStreetMap.
VITE_GOOGLE_MAPS_KEY=
# Firebase web app config (optional; enables Firebase Analytics after cookie consent). Firebase console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
# Firebase auth domain, e.g. myproject.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
# Firebase Realtime Database URL (optional)
VITE_FIREBASE_DATABASE_URL=
# Firebase project id
VITE_FIREBASE_PROJECT_ID=
# Firebase storage bucket
VITE_FIREBASE_STORAGE_BUCKET=
# Firebase messaging sender id
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Firebase app id
VITE_FIREBASE_APP_ID=
# Google Analytics 4 measurement id (G-XXXX); analytics stays off when empty
VITE_FIREBASE_MEASUREMENT_ID=
